{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theopenlane/agent/internal/config/config",
  "$ref": "#/$defs/Config",
  "$defs": {
    "ActionCommand": {
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workDir": {
          "type": "string"
        },
        "env": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "timeout": {
          "type": "integer"
        },
        "continueOnError": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "command"
      ]
    },
    "ActionConfig": {
      "properties": {
        "uploadEvidence": {
          "type": "boolean"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/ActionCommand"
          },
          "type": "array"
        },
        "updateControlStatus": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Check": {
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workDir": {
          "type": "string"
        },
        "env": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schedule": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        },
        "controls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "continueOnError": {
          "type": "boolean"
        },
        "evidencePaths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "onPass": {
          "$ref": "#/$defs/ActionConfig"
        },
        "onFail": {
          "$ref": "#/$defs/ActionConfig"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "command",
        "schedule"
      ]
    },
    "Config": {
      "properties": {
        "registrationToken": {
          "type": "string"
        },
        "apiUrl": {
          "type": "string"
        },
        "agentId": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "logLevel": {
          "type": "string"
        },
        "dataDir": {
          "type": "string"
        },
        "pollInterval": {
          "type": "integer"
        },
        "spawn": {
          "type": "integer"
        },
        "maxConcurrency": {
          "type": "integer"
        },
        "defaultTimeout": {
          "type": "integer"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceConfig"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "registrationToken"
      ]
    },
    "EvidenceConfig": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "retentionPeriod": {
          "type": "integer"
        },
        "maxFileSize": {
          "type": "integer"
        },
        "compressFiles": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "Openlane Agent Configuration",
  "description": "Configuration schema for the Openlane compliance automation agent"
}