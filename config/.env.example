# Openlane Agent Environment Variables
# This file contains all configurable environment variables for the agent
# Copy this file to .env and customize as needed

# Token used to register with the Openlane platform (SENSITIVE - set in production)
# OPENLANE_AGENT_REGISTRATIONTOKEN=""

# Base URL for the Openlane API
OPENLANE_AGENT_APIURL="https://api.theopenlane.io"

# Unique identifier for this agent instance
OPENLANE_AGENT_AGENTID=""

# Human-readable name for this agent
OPENLANE_AGENT_AGENTNAME=""

# Log level (debug, info, warn, error)
OPENLANE_AGENT_LOGLEVEL="info"

# Directory for storing agent data
OPENLANE_AGENT_DATADIR="./data"

# Interval for polling the platform for work
OPENLANE_AGENT_POLLINTERVAL="1m"

# Number of worker processes to spawn
OPENLANE_AGENT_SPAWN="1"

# Maximum number of concurrent check executions
OPENLANE_AGENT_MAXCONCURRENCY="3"

# Default timeout for check execution
OPENLANE_AGENT_DEFAULTTIMEOUT="5m"

# Enable evidence collection
OPENLANE_AGENT_EVIDENCE_ENABLED="true"

# How long to retain evidence files
OPENLANE_AGENT_EVIDENCE_RETENTIONPERIOD="30d"

# Maximum evidence file size in bytes (100MB default)
OPENLANE_AGENT_EVIDENCE_MAXFILESIZE="104857600"

# Compress evidence files to save space
OPENLANE_AGENT_EVIDENCE_COMPRESSFILES="false"

# Operation mode: normal, standalone, or buffered
OPENLANE_AGENT_OFFLINE_MODE="normal"

# Directory for storing results in standalone mode
OPENLANE_AGENT_OFFLINE_OUTPUTDIR="./results"

# Output format for standalone mode: json, yaml, csv
OPENLANE_AGENT_OFFLINE_OUTPUTFORMAT="json"

# Directory for storing buffered results when offline
OPENLANE_AGENT_OFFLINE_BUFFERDIR="./buffer"

# URL endpoint for connectivity checks (defaults to API URL + /livez)
OPENLANE_AGENT_OFFLINE_CONNECTIVITYCHECKURL=""

# Interval for connectivity checks
OPENLANE_AGENT_OFFLINE_CONNECTIVITYINTERVAL="30s"

# Interval for periodic sync attempts
OPENLANE_AGENT_OFFLINE_SYNCINTERVAL="5m"

# Maximum retry attempts for buffered results before giving up
OPENLANE_AGENT_OFFLINE_MAXRETRIES="5"

# How long to retain buffered results before cleanup
OPENLANE_AGENT_OFFLINE_BUFFERRETENTIONPERIOD="7d"

# Maximum number of retry attempts
OPENLANE_AGENT_RETRY_MAXATTEMPTS="5"

# Initial delay between retries
OPENLANE_AGENT_RETRY_INITIALDELAY="1s"

# Maximum delay between retries
OPENLANE_AGENT_RETRY_MAXDELAY="30s"

# Retry strategy: exponential, linear, random
OPENLANE_AGENT_RETRY_STRATEGY="exponential"

# Backoff multiplier for exponential strategy
OPENLANE_AGENT_RETRY_MULTIPLIER="2.0"

# Enable hardware ID detection
OPENLANE_AGENT_IDENTITY_ENABLED="true"

# How long to cache hardware ID before re-detection
OPENLANE_AGENT_IDENTITY_CACHETIMEOUT="24h"

# Use hostname-based fallback if hardware detection fails
OPENLANE_AGENT_IDENTITY_FALLBACKTOHOSTNAME="true"

# Override hardware ID with this value instead of detection
OPENLANE_AGENT_IDENTITY_OVERRIDEHARDWAREID=""

# Local compliance checks to execute
OPENLANE_AGENT_CHECKS=""

